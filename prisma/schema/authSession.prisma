// Add this model to prisma/schema/auth.prisma

model authSession {
    id             String    @id @default(uuid())
    userId         String
    refreshToken   String    @unique
    expiresAt      DateTime
    userAgent      String?
    ipAddress      String?
    revoked        Boolean   @default(false)
    createdAt      DateTime  @default(now())
    lastActivityAt DateTime?

    // Relations
    authUser authUser @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([refreshToken])
    @@index([expiresAt])
    @@map("auth_session")
}

// Then update authUser model to include the relation:
model authUser {
    // ... existing fields ...

    // Add this to relations section:
    authSessions authSession[]

    // ... rest of model ...
}
