// ================================
// Auth User Model
// ================================

model authUser {
    id           String     @id @default(uuid())
    email        String     @unique
    password     String
    username     String     @unique
    role         userRole   @default(USER)
    verified     Boolean    @default(false)
    status       userStatus @default(ACTIVE)
    tokenVersion Int        @default(1) // For immediate JWT revocation on security events
    deletedAt    DateTime?
    provider     String     @default("local")
    providerId   String?
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    // Relations
    userProfile       userProfile?
    authSecurity      authSecurity?
    loginHistory      loginHistory[]
    emailHistory      emailHistory[]
    activityLogEvents ActivityLogEvent[]
    subscriptions     Subscription[]
    authSessions      authSession[]

    @@index([email, id, providerId])
    @@index([username])
}

// ================================
// Auth Security Model
// ================================

model authSecurity {
    id                 String     @id @default(uuid())
    authId             String     @unique
    failedAttempts     Int        @default(0)
    lastFailedAt       DateTime?
    lockExpiresAt      DateTime?
    mfaEnabled         Boolean    @default(false)
    mfaMethod          mfaMethod?
    mfaSecret          String?
    createdAt          DateTime   @default(now())
    updatedAt          DateTime   @updatedAt
    lastPasswordChange DateTime?

    // Relations
    authUser authUser @relation(fields: [authId], references: [id], onDelete: Cascade)

    @@index([authId])
}

// ================================
// Auth Session Model
// ================================

model authSession {
    id             String    @id @default(uuid())
    userId         String
    refreshToken   String    @unique
    expiresAt      DateTime
    userAgent      String?
    ipAddress      String?
    revoked        Boolean   @default(false)
    createdAt      DateTime  @default(now())
    lastActivityAt DateTime?

    // Relations
    authUser authUser @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([refreshToken])
    @@index([expiresAt])
    @@map("auth_session")
}
